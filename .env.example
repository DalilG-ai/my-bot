# Токен арбитражного бота — получить у @BotFather. НЕ коммитить реальный токен.
ARBITRAGE_BOT_TOKEN=

# Список бирж (id из ccxt через запятую). По умолчанию используется широкий набор.
EXCHANGES=binance,bybit,okx,kucoin,gateio,mexc,htx,bitget,coinex,bingx

# Минимальный спред в процентах, при котором присылается уведомление
MIN_SPREAD_PERCENT=1.0

# Как часто сканировать биржи, в секундах
POLL_INTERVAL_SECONDS=45

# Не слать повторное уведомление по той же паре раньше, чем через N секунд
# (если спред не вырос значительно)
ALERT_COOLDOWN_SECONDS=900
SPREAD_INCREASE_TO_REALERT=0.5

# Сколько возможностей максимум класть в одно сообщение
MAX_ALERTS_PER_MESSAGE=15

# Отсекать пары с суточным оборотом (в котируемой валюте) ниже этого значения
MIN_QUOTE_VOLUME_USD=50000

# Таймаут запроса к бирже, секунды
FETCH_TIMEOUT_SECONDS=20
