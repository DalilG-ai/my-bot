# Скопируйте этот файл в .env и впишите свои значения.
# .env в git не попадает (см. .gitignore) — так токены не утекут в репозиторий.

# Обязательно: токен бота от @BotFather
ARBITRAGE_BOT_TOKEN=

# Опционально — если api.telegram.org недоступен напрямую (блокировки/троттлинг
# у провайдера) и нужен прокси. Для socks5:// понадобится ещё
# pip install "httpx[socks]"
# TELEGRAM_PROXY_URL=http://127.0.0.1:8080

# Опционально — только для чтения спредов с фото из Telegram-канала:
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_STRING=
# ANTHROPIC_API_KEY=
# CHANNEL_USERNAME=funding_watchdog
